import { testEmail, testPhone } from './test-fixtures.mjs';
import assert from 'node:assert/strict';
import {orderReceipt,type ReceiptOrder} from '../src/lib/email-template.ts';
import {trustedOrigin} from '../src/lib/trusted-origin.ts';
const site='https://shop.example';
assert(trustedOrigin(site,['http://localhost:3000',site], 'internal-proxy',true));
assert(!trustedOrigin('https://evil.example',[site],'evil.example',true));
assert(!trustedOrigin('https://shop.example.evil.example',[site],null,true));
assert(!trustedOrigin(null,[site],null,true));
assert(!trustedOrigin('http://shop.example',[site],null,true));
assert(trustedOrigin('http://localhost:3000',[], 'localhost:3000',false));
assert(!trustedOrigin('http://localhost:3000',[], 'localhost:3000',true));
const order:ReceiptOrder={number:'LB-ABCDEFGH',customer_name:'<script>Buyer</script>',email:testEmail('buyer'),phone:testPhone(),address:{line1:'Road & Lane',city:'Srinagar'},subtotal_paise:200000,discount_paise:10000,shipping_paise:25000,total_paise:215000,is_test:true,order_items:[{name:'Shawl <b>Gold</b>',size:'M',colour:'Gold',qty:2,unit_price_paise:100000}]};
const customer=orderReceipt(order,site),owner=orderReceipt(order,site,true);
assert(customer.text.includes('2 × Shawl'));
assert(customer.html.includes('Shawl &lt;b&gt;Gold&lt;/b&gt;'));
assert(!customer.html.includes('<script>'));
assert(customer.html.includes('https://shop.example/track/'));
assert(customer.text.includes('TEST PAYMENT'));
assert(customer.text.includes('2,150'));
assert(!customer.text.includes(order.email));
assert(owner.text.includes(order.email)&&owner.text.includes(order.phone));
assert(!orderReceipt(order,'javascript:alert(1)').html.includes('href='));
console.log('PASS trusted origins, hostile origins, local login, itemized receipts, totals, test-payment label, customer privacy and HTML escaping');
