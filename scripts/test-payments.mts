import { testEmail, testPhone, testSecret } from './test-fixtures.mjs';
import { PGlite } from "@electric-sql/pglite";
import { readFile } from "node:fs/promises";
import { createHmac,randomUUID } from "node:crypto";
import assert from "node:assert/strict";
import { signatureValid } from "../src/lib/razorpay";

const db=new PGlite();
const test=(name:string)=>console.log(`PASS ${name}`);
try {
  await db.exec("create role anon; create role authenticated; create role service_role bypassrls; create schema auth; create table auth.users(id uuid primary key); create schema storage; create table storage.buckets(id text primary key,name text,public boolean,file_size_limit bigint,allowed_mime_types text[]);");
  const schema=(await readFile("supabase/schema.sql","utf8")).replace("create extension if not exists pgcrypto;","-- UUID generation is built into PGlite.");
  await db.exec(schema);await db.exec(await readFile("supabase/part2.sql","utf8"));await db.exec(await readFile("supabase/part2.sql","utf8"));
  await db.exec("insert into public.categories(slug,name) values('shawls','Shawls'); insert into public.settings(id,shipping_fee_paise,free_shipping_threshold_paise) values(1,25000,500000);");
  const category=(await db.query<{id:string}>("select id from public.categories limit 1")).rows[0].id;
  const product=(await db.query<{id:string}>("insert into public.products(slug,name,category_id,price_paise,status,images) values('test-shawl','Test Shawl',$1,1250000,'published','[]') returning id",[category])).rows[0].id;
  const variant=(await db.query<{id:string}>("insert into public.variants(product_id,sku,size,colour,stock) values($1,'TEST-SHAWL-S-NATURAL','S','Natural',8) returning id",[product])).rows[0].id;
  await db.exec("insert into public.discount_codes(code,kind,value,max_uses) values('WELCOME10','percent',10,5);");
  await db.exec("set role service_role;");
  const items=[{variant_id:variant,qty:1}],customer={name:"Test Buyer",email:testEmail('buyer'),mobile:testPhone(),address:{line1:"12 Test Road",line2:"",city:"Srinagar",state:"Jammu and Kashmir",pin:"190001"}};
  const quote=async (code:string)=>((await db.query<{q:{total_paise:number;subtotal_paise:number;discount_paise:number;shipping_paise:number}}>("select public.quote_order($1::jsonb,$2) q",[JSON.stringify(items),code])).rows[0].q);
  const total=await quote("WELCOME10");assert.deepEqual([total.subtotal_paise,total.discount_paise,total.shipping_paise,total.total_paise],[1250000,125000,0,1125000]);test("server price, discount and shipping in integer paise");
  const create=async (token:string)=>((await db.query<{o:{id:string;number:string;total_paise:number}}>("select public.create_order($1::uuid,$2::jsonb,$3::jsonb,'WELCOME10',$4,true) o",[token,JSON.stringify(items),JSON.stringify(customer),total.total_paise])).rows[0].o);
  const token=randomUUID(),order=await create(token),same=await create(token);
  assert.equal(order.id,same.id);assert.match(order.number,/^LB-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$/);
  assert.equal((await db.query<{n:number}>("select count(*)::integer n from public.orders")).rows[0].n,1);test("double-click idempotency, non-sequential order number");
  const current=(await db.query<{available:number}>("select available from public.storefront_variants() where id=$1",[variant])).rows[0].available;assert.equal(current,7);test("reservation reduces public availability");
  await assert.rejects(()=>db.query("select public.create_order($1::uuid,$2::jsonb,$3::jsonb,'WELCOME10',100,true)",[randomUUID(),JSON.stringify(items),JSON.stringify(customer)]));test("browser total tampering rejected");
  const secret=testSecret(),razorId="order_localfixture",payId="pay_localfixture",signature=createHmac("sha256",secret).update(`${razorId}|${payId}`).digest("hex");
  assert.equal(signatureValid(`${razorId}|${payId}`,signature,secret),true);
  assert.equal(signatureValid(`${razorId}|${payId}`,"0".repeat(64),secret),false);test("valid and wrong signatures");
  const paid=await db.query<{changed:boolean}>("select public.mark_order_paid($1::uuid,$2,$3) changed",[order.id,payId,total.total_paise]);
  assert.equal(paid.rows[0].changed,true);
  const replay=await db.query<{changed:boolean}>("select public.mark_order_paid($1::uuid,$2,$3) changed",[order.id,payId,total.total_paise]);
  assert.equal(replay.rows[0].changed,false);
  assert.equal((await db.query<{stock:number}>("select stock from public.variants where id=$1",[variant])).rows[0].stock,7);
  assert.equal((await db.query<{used_count:number}>("select used_count from public.discount_codes where code='WELCOME10'")).rows[0].used_count,1);test("paid transition, one stock decrement and replay safety");
  const mismatch=await create(randomUUID());await db.query("select public.mark_order_paid($1::uuid,$2,$3)",[mismatch.id,"pay_amountmismatch",1]);
  assert.equal((await db.query<{needs_attention:boolean}>("select needs_attention from public.orders where id=$1",[mismatch.id])).rows[0].needs_attention,true);test("captured amount mismatch is flagged");
  const late=await create(randomUUID());await db.query("update public.stock_reservations set expires_at=now()-interval '1 minute' where order_id=$1",[late.id]);
  await db.query("select public.mark_order_paid($1::uuid,$2,$3)",[late.id,"pay_late",total.total_paise]);
  assert.equal((await db.query<{needs_attention:boolean}>("select needs_attention from public.orders where id=$1",[late.id])).rows[0].needs_attention,true);test("expired paid reservation is flagged");
  const failed=await create(randomUUID());await db.query("select public.mark_order_failed($1::uuid,'evt_failure')",[failed.id]);
  assert.equal((await db.query<{n:number}>("select count(*)::integer n from public.stock_reservations where order_id=$1",[failed.id])).rows[0].n,0);test("failed payment releases reservation");
  const stockBefore=(await db.query<{stock:number}>("select stock from public.variants where id=$1",[variant])).rows[0].stock;
  const cancelled=await db.query<{changed:boolean}>("select public.cancel_order($1::uuid,true) changed",[order.id]);
  assert.equal(cancelled.rows[0].changed,true);
  assert.equal((await db.query<{stock:number}>("select stock from public.variants where id=$1",[variant])).rows[0].stock,stockBefore+1);
  assert.equal((await db.query<{changed:boolean}>("select public.cancel_order($1::uuid,true) changed",[order.id])).rows[0].changed,false);test("paid cancellation restocks once");
  await db.query("update public.variants set stock=0 where id=$1",[variant]);
  await assert.rejects(()=>quote(""));test("sold-out stock blocks checkout quote");
  await db.exec("set role anon");
  await assert.rejects(()=>db.query("select public.create_order(gen_random_uuid(),'[]','{}','',100,true)"));
  await assert.rejects(()=>db.query("select * from public.orders"));test("anonymous order functions and rows blocked");
  console.log("Payment transaction checks passed. No network payment, email or live Supabase records were created.");
}finally{await db.close();}
