{
  "name": "libaas",
  "version": "1.0.0",
  "description": "Kashmiri clothing storefront with catalogue management and secure checkout",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "prebuild": "npm run optimize",
    "start": "next start",
    "optimize": "node scripts/optimize-images.mjs",
    "shots": "node scripts/screenshots.mjs",
    "check": "tsc --noEmit && eslint . && npm run build",
    "audit:site": "node scripts/audit.mjs",
    "seed": "tsx scripts/seed.ts",
    "test:payments": "node --conditions=react-server --import tsx scripts/test-payments.mts",
    "test:admin": "node scripts/test-admin.mjs",
    "test:rls": "node --env-file=.env.local scripts/test-rls.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:money": "node --import tsx scripts/test-money.mts",
    "test:admin-data": "node --import tsx scripts/test-admin-data.mts",
    "test:checkout": "node scripts/test-checkout.mjs",
    "test:checkout-failures": "node scripts/test-checkout-failures.mjs",
    "benchmark:admin": "node scripts/admin-benchmark.mjs",
    "test:admin-forms": "node scripts/test-admin-forms.mjs",
    "test:admin-access": "node scripts/test-admin-access.mjs",
    "test:footer": "node scripts/test-footer.mjs",
    "test:categories": "node scripts/test-categories.mjs",
    "test:store-fixes": "node --import tsx scripts/test-store-fixes.mts && node --conditions=react-server --import tsx scripts/test-email-delivery.mts",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "test:mobile": "node scripts/test-mobile.mjs"
  },
  "type": "module",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.7",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
